# TypeSafe API key for Jev (required only for --live). Get one at https://typesafe.ai.
# This is an empty placeholder. Never commit a real key. At runtime the key is read
# from the environment, then <repo>/.env, then ~/jev-ultrafast/.env, and is never
# printed, logged, or written to disk.
TYPESAFE_API_KEY=
# Optional: defaults to jev-latest.
TYPESAFE_MODEL=jev-latest

# Optional text LLM for drafting candidate replies (only used with --drafts llm).
# Offline/template drafting needs no key. When set, this is the ONLY component that
# generates free text; Jev itself never writes a reply.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://api.deepseek.com/v1
TEXT_MODEL=deepseek-chat
